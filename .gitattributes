# Normalizar fin de línea a LF en todo el repo (evita que CRLF de Windows rompa
# los scripts de shell / Dockerfile en el contenedor Linux).
* text=auto eol=lf

# Binarios: nunca tocar.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.xlsx binary
*.xls  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.zip  binary
*.exe  binary
*.bmp  binary
